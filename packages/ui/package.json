{
  "name": "@flowtomic/ui",
  "version": "2.0.0",
  "description": "Componentes UI reutilizáveis baseados em Radix UI e Tailwind CSS",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./components/*": {
      "import": "./dist/components/*/index.js",
      "types": "./dist/components/*/index.d.ts"
    },
    "./styles/*": "./dist/styles/*",
    "./dist/index.css": "./dist/index.css",
    "./styles/fonts.css": "./dist/styles/fonts.css"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaimeJunr/Flowtomic.git"
  },
  "author": "JaimeJunr",
  "license": "MIT",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "biome check . 2>&1 | (! grep -q 'error:' || exit 1) && tsc --build && bun build --production ./src/index.ts --outdir ./dist --target browser --format esm --minify --packages external && bun run build:rewrite-aliases && bun run build:copy-styles",
    "build:rewrite-aliases": "bun run ../../scripts/rewrite-ui-aliases.ts",
    "build:copy-styles": "bun run ../../scripts/copy-ui-styles.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "storybook": "storybook dev -p 6006 --config-dir ../../.storybook",
    "build-storybook": "storybook build --config-dir ../../.storybook --output-dir ../../storybook-static"
  },
