{
  "name": "@flowtomic/logic",
  "version": "0.1.8",
  "description": "Hooks headless e lógica reutilizável para React",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./hooks/*": {
      "import": "./dist/hooks/*/index.js",
      "types": "./dist/hooks/*/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaimeJunr/Flowtomic.git"
  },
  "author": "JaimeJunr",
  "license": "MIT",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "biome check . && tsc --emitDeclarationOnly && bun build --production ./src/index.ts --outdir ./dist --target browser --format esm --minify --external react --external react/jsx-runtime",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@tanstack/react-table": "^8.21.3",
    "react-resizable-panels": "^4.6.5"
  },
  "dependencies": {
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.1.16",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.9.2",
    "jsdom": "^25.0.1",
    "react": "^19.1.1",
    "react-resizable-panels": "^4.6.5",
    "typescript": "~5.9.3",
    "vitest": "^2.1.8"
  }
}
