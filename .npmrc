# O escopo @flowtomic é público e vai SEMPRE pro npm, nunca pro registry que
# estiver como default na máquina. Sem esta linha, um `npm publish` numa máquina
# com registry corporativo no ~/.npmrc global publica o pacote lá por engano.
@flowtomic:registry=https://registry.npmjs.org/

# Default do repo também é o npm público. Sem isto, o registry corporativo do
# ~/.npmrc da máquina vaza pro bun.lock e a CI (sem credencial) trava no install.
registry=https://registry.npmjs.org/
